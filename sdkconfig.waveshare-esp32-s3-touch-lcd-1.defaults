# Waveshare ESP32-S3-Touch-LCD-1.28 (ESP32-S3R2, 16MB flash, 2MB PSRAM, GC9A01 240×240)
CONFIG_WAVESHARE_ESP32_S3_TOUCH_LCD_128=y

CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ESP32-S3R2 has 2MB embedded PSRAM (octal). If boot loops with
# "octal_psram: PSRAM chip is not connected", keep SPIRAM off and use smaller LVGL buffers.
# CONFIG_SPIRAM is not set

# LVGL + BLE firmware exceeds default 1MB factory partition (use 2M app)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_waveshare.csv"

# LVGL status screen — readable on 1.28" round panel (~32 mm diameter)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
