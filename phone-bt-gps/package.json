{
  "name": "phone-bt-gps",
  "version": "1.0.0",
  "private": true,
  "description": "Push phone GPS to Osmo camera over BLE (DJI R SDK protocol)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@ascentio-it/capacitor-bluetooth-serial": "^8.0.0",
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@ionic/vue": "^8.8.8",
    "@ionic/vue-router": "^8.8.8",
    "ionicons": "^7.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
